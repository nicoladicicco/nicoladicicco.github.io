---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import { LOCALES, formatDate, localeStaticPaths, toLang } from '../../../utils/i18n';
import { getPosts } from '../../../utils/blog';

export const getStaticPaths = localeStaticPaths;

const lang = toLang(Astro.currentLocale);
const t = LOCALES[lang];
const posts = (await getPosts()).filter((entry) => entry.lang === lang);
---

<Layout title={t.blog} description={t.blogDescription}>
	<div class="prose">
		<h1>{t.blog}</h1>

		{posts.length === 0 && <p>{t.empty}</p>}

		<ul class="posts plain-list">
			{
				posts.map(({ post, slug }) => (
					<li>
						<article>
							<h2>
								<a href={getRelativeLocaleUrl(lang, `blog/${slug}`)}>{post.data.title}</a>
							</h2>
							<time datetime={post.data.pubDate}>{formatDate(post.data.pubDate, lang)}</time>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</Layout>

<style>
	.posts > li + li {
		margin-top: calc(var(--space) * 2);
	}

	.posts h2 {
		font-size: 1.2rem;
		margin: 0 0 0.15rem;
	}

	time {
		display: block;
		font-size: 0.875rem;
		color: var(--muted);
	}
</style>
